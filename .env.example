# Exclusivamente no servidor. Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
# Configure em .env.local (ignorado pelo Git) ou no gerenciador seguro do servidor.
# Chave OpenAI. AI_PROVIDER_API_KEY também permite binding via proxy no ambiente cloud.
AI_PROVIDER_API_KEY=
# Alternativa local reconhecida: OPENAI_API_KEY (não é necessário definir ambas).
# Modelo com suporte a Responses API + Structured Outputs.
OPENAI_DIAGNOSIS_MODEL=gpt-4.1-mini
# Código de acesso independente da chave OpenAI: ao menos 32 caracteres aleatórios.
# Forneça-o somente a quem pode usar o orçamento. Deve ser um valor real no processo,
# não um placeholder de segredo substituído apenas por proxy de saída.
DIAGNOSIS_ACCESS_TOKEN=
# Origem pública exata (sem barra final). Opcional fora de proxy reverso:
# quando ausente, a origem é derivada da URL da requisição.
APP_ORIGIN=http://localhost:3000
